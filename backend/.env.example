# Database Configuration
# For local development, use SQLite (default)
DATABASE_CLIENT=sqlite
# SQLITE_FILENAME=.tmp/data.db

# For production, use PostgreSQL
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://username:password@localhost:5432/toast2host

# Strapi Configuration
HOST=0.0.0.0
PORT=1337
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified

# Google OAuth (Required for authentication)
# Get these from https://console.cloud.google.com/
PROVIDER_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
PROVIDER_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Application Settings
CONSENT_REQUIRED=true
DAILY_CONNECT_CAP=10
NOTIFICATIONS_EMAIL_ENABLED=false
