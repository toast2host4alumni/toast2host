# Test Environment Variables
# Copy this file to .env.test and fill in the values

# Strapi Backend URL
STRAPI_URL=http://localhost:1337

# Frontend URL
BASE_URL=http://localhost:3000

# Strapi Admin Credentials (for test data management)
# Option 1: Provide admin JWT token directly (recommended for CI)
STRAPI_ADMIN_JWT=your-admin-jwt-token-here

# Option 2: Provide admin credentials (will auto-login)
STRAPI_ADMIN_EMAIL=admin@example.com
STRAPI_ADMIN_PASSWORD=AdminPassword123!

# Optional: Custom test configuration
# TEST_TIMEOUT=30000
# HEADLESS=true
